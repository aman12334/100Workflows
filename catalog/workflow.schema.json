{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "category": {
      "type": "string",
      "enum": [
        "gtm",
        "marketing",
        "sales",
        "finance",
        "product",
        "user-research",
        "operations"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "planned"
      ]
    },
    "problems": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "tags": {
      "default": [],
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "inputs": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "use": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "use",
              "required"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "long_text",
                  "url",
                  "number",
                  "select",
                  "list"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "shared": {
                "default": false,
                "type": "boolean"
              },
              "options": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "example": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "required",
              "description"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "outputs": {
      "minItems": 1,
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "json",
              "table",
              "list"
            ]
          }
        },
        "required": [
          "key",
          "label",
          "description",
          "format"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent",
              "check"
            ]
          },
          "responsibility": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "tools": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "mode": {
            "type": "string",
            "enum": [
              "generate",
              "revise",
              "gather",
              "extract"
            ]
          },
          "gather": {
            "type": "object",
            "properties": {
              "search": {
                "type": "object",
                "properties": {
                  "maxSearches": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "required": [
                  "maxSearches"
                ],
                "additionalProperties": false
              },
              "fetch": {
                "type": "object",
                "properties": {
                  "urlInputs": {
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "fromSearch": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "maxPages": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": [
                  "maxPages"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "calculate": {
            "type": "object",
            "properties": {
              "calculation": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*@\\d+$"
              },
              "inputs": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "as": {
                      "type": "string",
                      "enum": [
                        "number",
                        "text",
                        "number_list"
                      ]
                    }
                  },
                  "required": [
                    "input",
                    "as"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "calculation"
            ],
            "additionalProperties": false
          },
          "reads": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "pattern": "^[a-z_]+\\.[a-z_]+@\\d+$"
                },
                "params": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "input": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$"
                          },
                          "as": {
                            "type": "string",
                            "enum": [
                              "number",
                              "text",
                              "text_list",
                              "number_list",
                              "email_list",
                              "boolean"
                            ]
                          }
                        },
                        "required": [
                          "input",
                          "as"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 500
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              }
                            ]
                          }
                        },
                        "required": [
                          "value"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "action"
              ],
              "additionalProperties": false
            }
          },
          "propose": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "pattern": "^[a-z_]+\\.[a-z_]+@\\d+$"
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "action",
                "from"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "responsibility"
        ],
        "additionalProperties": false
      }
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "purpose",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "integrations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "purpose",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workflowId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "workflowId",
          "required",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "criteria": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "method": {
                "type": "string",
                "enum": [
                  "schema",
                  "rule",
                  "model"
                ]
              },
              "critical": {
                "default": false,
                "type": "boolean"
              },
              "rule": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "step": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "params": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "id",
                  "params"
                ],
                "additionalProperties": false
              },
              "review": {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "rubric": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "passAt": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "required": [
                  "step",
                  "rubric"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "description",
              "method"
            ],
            "additionalProperties": false
          }
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "criteria",
        "threshold"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1800
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "maxRetries",
        "timeoutSeconds",
        "maxModelCalls"
      ],
      "additionalProperties": false
    },
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "execution": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "const": "generic"
        },
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 16000
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "engine",
        "system"
      ],
      "additionalProperties": false
    },
    "outputSchema": {}
  },
  "required": [
    "id",
    "version",
    "name",
    "category",
    "summary",
    "description",
    "status",
    "problems",
    "inputs",
    "outputs",
    "steps",
    "evaluation",
    "limits"
  ],
  "additionalProperties": false,
  "title": "100 Workflows: workflow definition"
}
