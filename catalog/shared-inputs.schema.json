{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "long_text",
              "url",
              "number",
              "select",
              "list"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "options": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "example": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "key",
          "label",
          "type",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "inputs"
  ],
  "additionalProperties": false,
  "title": "100 Workflows: shared inputs"
}
