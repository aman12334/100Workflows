# Copy to .env.local (or run `npm run setup` for Anthropic). .env.local is git-ignored.
# Set ONE provider key. Usage is billed to that provider account.

# Anthropic (Claude). Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT). Create a key at https://platform.openai.com/api-keys
# Market Research needs web search, which is only available with Anthropic for now.
OPENAI_API_KEY=

# Optional: with both keys set, choose explicitly: anthropic | openai
# WORKFLOWS_PROVIDER=

# Optional: override the model. Defaults: claude-opus-5-5 (Anthropic), gpt-6.1-sol (OpenAI).
# WORKFLOWS_MODEL=

# Optional: extra hostnames allowed to reach the API routes (comma-separated).
# Leave empty to accept only localhost / 127.0.0.1 / [::1].
# WORKFLOWS_ALLOWED_HOSTS=

# Optional: where the local SQLite database lives. Default: ./data/100-workflows.db
# WORKFLOWS_DB_PATH=

# Web search for Market Research and the research workflows (Anthropic's server-side web search tool).
# Off by default because Anthropic bills searches separately. Set to "on" to enable.
# WORKFLOWS_WEB_SEARCH=on

# Reading public web pages for research workflows (built in; runs on this computer, GET only,
# public addresses only). Off by default. Set to "on" to enable. Works with either provider.
# WORKFLOWS_WEB_FETCH=on

# Model-based review of workflow outputs (one extra low-effort call per attempt). Set to "off" to skip.
# WORKFLOWS_MODEL_REVIEW=off

# ---------------------------------------------------------------- external actions (Phase 4)
# Integration workflows only PROPOSE actions; each runs once, after you approve its exact payload.
# Approvals are dry runs (nothing is sent) unless this is "live".
# WORKFLOWS_ACTIONS=live
# Name recorded as the approver in the audit trail. Default: local user
# WORKFLOWS_OPERATOR=

# Provider settings. Values stay in this file; the app shows only which names are missing.
# See docs/integrations.md for the exact permissions to grant (use the minimum).
# Resend (email)
# RESEND_API_KEY=
# RESEND_FROM="Your Name <you@your-verified-domain.com>"
# HubSpot private app token
# HUBSPOT_ACCESS_TOKEN=
# Slack bot token (xoxb-...)
# SLACK_BOT_TOKEN=
# Google Calendar (OAuth client + a refresh token you obtained for calendar.freebusy and calendar.events)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# Linear personal API key and the team new issues go to
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# Stripe RESTRICTED key (rk_...) with Invoices: Read only. Full secret keys (sk_...) are refused.
# STRIPE_API_KEY=
# Mastodon
# MASTODON_INSTANCE_URL=https://mastodon.example
# MASTODON_ACCESS_TOKEN=

# ---------------------------------------------------------------- access and storage (Phase 5)
# Require sign-in for every page and API (24+ characters). Set this before letting anyone else reach the app.
# WORKFLOWS_ACCESS_TOKEN=
# Where builder workflows are saved. Default: ./data/custom-workflows. "off" disables them.
# WORKFLOWS_CUSTOM_DIR=
