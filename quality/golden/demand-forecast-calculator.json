  "rubric": [
    {
      "id": "accurate",
      "question": "Is everything stated consistent with the inputs (and sources, where used), with nothing invented?"
    },
    {
      "id": "useful",
      "question": "Would the intended user act on this output with little or no editing?"
    },
    {
      "id": "complete",
      "question": "Does it cover everything the task asks for, without padding?"
    },
    {
      "id": "explanation_faithful",
      "question": "Does the explanation describe the calculated results correctly, without new numbers?"
    },
    {
      "id": "summary_numbers",
      "question": "Every number in the summary comes from the calculation or your inputs."
    },
    {
      "id": "point_numbers",
      "question": "Every number in the key points comes from the calculation or your inputs."
    },
    {
      "id": "enough_points",
      "question": "Gives 2 to 8 key points."
    },
    {
      "id": "short_summary",
      "question": "The summary is 90 words or fewer."
    }
