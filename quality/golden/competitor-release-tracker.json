  "rubric": [
    {
      "id": "accurate",
      "question": "Is everything stated consistent with the inputs (and sources, where used), with nothing invented?"
    },
    {
      "id": "useful",
      "question": "Would the intended user act on this output with little or no editing?"
    },
    {
      "id": "complete",
      "question": "Does it cover everything the task asks for, without padding?"
    },
    {
      "id": "sources_support_claims",
      "question": "Does each cited source actually support the claim it is attached to?"
    },
    {
      "id": "releases_quoted",
      "question": "Every release quotes the changelog it cites."
    },
    {
      "id": "distinct_releases",
      "question": "No release is listed twice."
    }
  ],
  "expectedFailureBehavior": [
