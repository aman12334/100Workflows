  "rubric": [
    {
      "id": "accurate",
      "question": "Is everything stated consistent with the inputs (and sources, where used), with nothing invented?"
    },
    {
      "id": "useful",
      "question": "Would the intended user act on this output with little or no editing?"
    },
    {
      "id": "complete",
      "question": "Does it cover everything the task asks for, without padding?"
    },
    {
      "id": "actions_correct",
      "question": "Is every proposed action exactly what you would approve (right recipient or record, right content)?"
    },
