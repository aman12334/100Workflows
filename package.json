{
  "name": "100-workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, open-source catalog of agentic business workflows you discover through chat.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "setup": "node scripts/setup.mjs",
    "check:config": "node scripts/check-config.mjs",
    "catalog:validate": "node --conditions=react-server --import tsx scripts/validate-catalog.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "catalog:search": "node --conditions=react-server --import tsx scripts/catalog-search.ts",
    "catalog:schema": "tsx scripts/gen-schemas.ts",
    "catalog:docs": "node --conditions=react-server --import tsx scripts/catalog-docs.ts",
    "new:workflow": "node --conditions=react-server --import tsx scripts/new-workflow.ts",
    "check": "npm run typecheck && npm test && npm run catalog:validate -- --strict && npm run catalog:schema -- --check && npm run catalog:docs -- --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "openai": "^7.45.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
